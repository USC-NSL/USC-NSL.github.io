source 'https://rubygems.org'

# Versions are pinned to the minor release CI last built with, so a breaking
# upstream release can't silently break the deploy. Bump deliberately.
group :jekyll_plugins do
    gem 'jekyll', '~> 4.4'
    gem 'jekyll-scholar', '~> 7.3'
    gem 'jekyll-sitemap', '~> 1.4'
    gem 'jekyll-target-blank', '~> 2.0'
    gem 'jekyll-redirect-from', '~> 0.17'
end

# Stdlib gems no longer bundled with newer Ruby; needed to build/serve.
gem 'webrick', '~> 1.9'
gem 'csv', '~> 3.3'
gem 'observer', '~> 0.1'
